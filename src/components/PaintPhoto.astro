---
// Foto dentro de una ventana de dibujo: caja de herramientas a la izquierda,
// lienzo con la imagen y paleta de colores abajo. Las herramientas y la paleta
// son decorativas. La imagen pasa por astro:assets (se redimensiona y se
// convierte a un formato ligero automáticamente).
import { Image } from 'astro:assets';
import Window from './Window.astro';

interface Props {
  title: string;
  id: string;
  image: ImageMetadata;
  alt: string;
  /** Posición en la cascada de apertura. */
  index?: number;
  class?: string;
}

const { title, id, image, alt, index = 0, class: className } = Astro.props;

const swatches = ['#000000', '#7f7f7f', '#7f0000', '#7f7f00', '#007f00', '#007f7f', '#00007f', '#7f007f',
  '#ffffff', '#c0c0c0', '#ff0000', '#ffff00', '#00ff00', '#00ffff', '#0000ff', '#ff00ff'];
---

<Window title={title} id={id} icon="paint" flush index={index} class={className}>
  <div class="paint">
    <div class="tools" aria-hidden="true">
      {Array.from({ length: 12 }, () => <span />)}
    </div>
    <div class="canvas">
      <Image src={image} alt={alt} widths={[320, 480, 640]} sizes="(max-width: 40rem) 80vw, 22rem" loading="lazy" />
    </div>
    <div class="palette" aria-hidden="true">
      {swatches.map((c) => <span style={`background:${c}`} />)}
    </div>
  </div>
</Window>

<style>
  .paint {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    grid-template-areas:
      'tools canvas'
      'palette palette';
    gap: var(--s-2);
    padding: var(--s-2);
  }

  .tools {
    grid-area: tools;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-content: start;
    gap: 2px;
  }

  .tools span {
    aspect-ratio: 1;
    background: var(--button);
    border: 1px solid var(--button-edge);
    box-shadow:
      inset 1px 1px 0 var(--button-hi),
      inset -1px -1px 0 var(--button-lo);
  }

  .canvas {
    grid-area: canvas;
    min-width: 0;
    background: var(--paper);
    border: 1px solid var(--window-line);
    box-shadow: inset 1px 1px 0 var(--button-lo);
  }

  .canvas :global(img) {
    width: 100%;
    height: auto;
  }

  .palette {
    grid-area: palette;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 2px;
    max-width: 16rem;
  }

  .palette span {
    aspect-ratio: 1.3;
    border: 1px solid var(--button-edge);
  }
</style>
