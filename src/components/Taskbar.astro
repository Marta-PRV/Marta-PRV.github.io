---
// Barra de tareas fija abajo (gris con bisel, estilo Windows 98) = navegación del sitio.
//  - Inicio: menú con la API nativa `popover` (Esc, clic fuera y foco los gestiona el navegador).
//  - Botones de ventanas abiertas: los rellena windowManager.ts en PC (un botón por ventana).
//  - Sin JS, o en móvil, se ven en su lugar los enlaces a las secciones.
//  - Recolocar: devuelve las ventanas a su sitio (solo existe con el gestor activo).
//  - Bandeja: idioma, tema y reloj decorativo.
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';
import { alternatePath, localePath, sectionSlug, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const home = localePath(lang);
const howHref = localePath(lang, sectionSlug(lang, 'como-esta-hecho'));
const onHow = Astro.url.pathname === howHref;

// `open` = id de la ventana: en PC el gestor la abre/trae al frente; en móvil el #ancla la abre a pantalla completa.
const sections = [
  { href: `${home}#proyectos`, label: t('nav.projects'), icon: 'folder' as const, open: undefined },
  { href: `${home}#sobre-mi`, label: t('nav.about'), icon: 'notepad' as const, open: 'sobre-mi' },
  { href: `${home}#tecnologias`, label: t('tech.title'), icon: 'folder' as const, open: 'tecnologias' },
  { href: `${home}#contacto`, label: t('nav.contact'), icon: 'mail' as const, open: 'contacto' },
];
---

<nav class="taskbar" aria-label={t('nav.label')}>
  <button class="start" type="button" popovertarget="start-menu" aria-label={t('nav.menu')}>
    <Icon name="start" size={24} />
    <span class="start__text">{t('nav.start')}</span>
  </button>

  <div id="start-menu" class="start-menu" popover>
    <ul>
      {sections.map((s) => (
        <li><a href={s.href} data-open={s.open}><Icon name={s.icon} size={32} />{s.label}</a></li>
      ))}
      <li class="start-menu__sep">
        <a href={howHref} aria-current={onHow ? 'page' : undefined}><Icon name="book" size={32} />{t('nav.how')}</a>
      </li>
    </ul>
  </div>

  <!-- Sin JS o en móvil: enlaces a las secciones -->
  <ul class="tasks tasks--links">
    {sections.map((s) => (
      <li><a class="task" href={s.href} data-open={s.open}><Icon name={s.icon} size={16} /><span>{s.label}</span></a></li>
    ))}
    <li>
      <a class="task" href={howHref} aria-current={onHow ? 'page' : undefined}><Icon name="book" size={16} /><span>{t('nav.how')}</span></a>
    </li>
  </ul>

  <!-- PC con JS: un botón por ventana abierta (los crea windowManager.ts) -->
  <ul class="tasks tasks--windows" data-tasks aria-label={t('desk.windows')}></ul>

  <button class="task task--reset" type="button" data-action="reset" title={t('desk.resetHint')} aria-label={t('desk.resetHint')}>
    <Icon name="folder" size={16} /><span>{t('desk.reset')}</span>
  </button>

  <div class="tray">
    <a class="tray__btn" href={alternatePath(Astro.url, other)} hreflang={other} lang={other} aria-label={t('lang.switch')}>
      <Icon name="globe" size={16} />{t('lang.short')}
    </a>
    <button
      class="tray__btn theme-toggle"
      type="button"
      data-to-light={t('theme.toLight')}
      data-to-dark={t('theme.toDark')}
      aria-label={t('theme.toDark')}
    >
      <span class="theme-toggle__moon"><Icon name="moon" size={16} /></span>
      <span class="theme-toggle__sun"><Icon name="sun" size={16} /></span>
    </button>
    <time class="clock" aria-hidden="true" data-lang={lang}></time>
  </div>
</nav>

<style>
  .taskbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 1000;
    display: flex;
    align-items: stretch;
    gap: 4px;
    height: var(--taskbar-h);
    padding: 3px 4px;
    color: var(--taskbar-text);
    background: var(--window);
    border-top: 1px solid var(--bevel-soft);
    box-shadow: inset 0 1px 0 var(--bevel-hi);
  }

  /* Botones biselados (Inicio, tareas, recolocar) */
  .start,
  .task {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0 var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    color: var(--taskbar-text);
    text-decoration: none;
    background: var(--window);
    border: 0;
    box-shadow: var(--bevel-out);
    cursor: pointer;
  }

  .start:active,
  .task:active,
  .start:has(+ .start-menu:popover-open),
  .task[aria-pressed='true'] {
    box-shadow: var(--bevel-in);
  }

  /* Ventana delantera: hundida y con la trama de puntos de la época */
  .task[aria-pressed='true'] {
    background:
      repeating-conic-gradient(var(--bevel-soft) 0 25%, var(--window) 0 50%) 0 0 / 2px 2px;
  }

  .start {
    padding-inline: var(--s-3);
    font-size: var(--text-lg);
  }

  .start-menu {
    position: fixed;
    inset: auto auto var(--taskbar-h) 0;
    margin: 0;
    padding: 3px;
    min-width: 16rem;
    max-width: calc(100vw - 1rem);
    color: var(--window-text);
    background: var(--window);
    border: 1px solid var(--window-edge);
    box-shadow: var(--bevel-out);
  }

  .start-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .start-menu a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 2.75rem;
    padding: var(--s-1) var(--s-4) var(--s-1) var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-lg);
    color: inherit;
    text-decoration: none;
  }

  .start-menu a:hover,
  .start-menu a:focus-visible {
    background: var(--select);
    color: #fff;
  }

  .start-menu a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .start-menu__sep {
    margin-block-start: var(--s-1);
    padding-block-start: var(--s-1);
    border-top: 1px solid var(--window-line);
    box-shadow: inset 0 1px 0 var(--bevel-hi);
  }

  /* Listas de tareas: ocultas por defecto, se activan según el modo (ver al final) */
  .tasks {
    display: none;
    flex: 1;
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .tasks > li {
    display: flex;
    min-width: 0;
  }

  .tasks--windows > li {
    flex: 0 1 11rem;
    min-width: 5rem;
  }

  .task {
    min-width: 0;
    max-width: 100%;
  }

  .task > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tasks--windows .task {
    flex: 1;
  }

  .task--reset {
    display: none;
  }

  .tray {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-inline-start: auto;
    padding: 0 var(--s-2);
    background: var(--window);
    box-shadow: var(--bevel-in);
  }

  .tray__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-1);
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0 var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--taskbar-text);
    text-decoration: none;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .tray__btn:hover {
    background: color-mix(in srgb, var(--window-text) 12%, transparent);
  }

  .clock {
    display: none;
    padding-inline: var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* Un solo icono de tema visible: la luna en claro (para ir a oscuro), el sol en oscuro */
  .theme-toggle__sun,
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }

  /* PC (el mismo criterio que el gestor de ventanas): enlaces sin JS, botones de ventana con JS */
  @media (min-width: 52rem) and (min-height: 34rem) {
    :global(html:not(.wm)) .tasks--links,
    :global(html:has(.window--page)) .tasks--links {
      display: flex;
    }

    :global(html.wm:not(:has(.window--page))) .tasks--windows {
      display: flex;
    }

    :global(html.wm:not(:has(.window--page))) .task--reset {
      display: inline-flex;
    }

    .clock {
      display: block;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function syncLabel() {
    if (!toggle) return;
    const dark = root.dataset.theme === 'dark';
    toggle.setAttribute('aria-label', (dark ? toggle.dataset.toLight : toggle.dataset.toDark) ?? '');
  }

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* modo privado: el tema solo dura esta visita */
    }
    syncLabel();
  });
  syncLabel();

  // El menú Inicio se cierra al elegir una opción (los enlaces #ancla no recargan la página).
  const menu = document.getElementById('start-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));

  // Reloj decorativo (se oculta a lectores de pantalla)
  const clock = document.querySelector<HTMLTimeElement>('.clock');
  function tick() {
    if (clock) clock.textContent = new Date().toLocaleTimeString(clock.dataset.lang, { hour: '2-digit', minute: '2-digit' });
  }
  tick();
  setInterval(tick, 30_000);
</script>
