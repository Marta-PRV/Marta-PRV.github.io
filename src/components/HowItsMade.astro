---
// Página "Cómo está hecho": explica las decisiones de diseño y técnicas reales de este
// portfolio. El texto vive en src/data/howItsMade.ts (cada frase debe ser cierta).
import NotepadAbout from './NotepadAbout.astro';
import PageDesk from './PageDesk.astro';
import { howItsMade } from '../data/howItsMade';
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = howItsMade[lang];
---

<PageDesk lang={lang} title={`${page.heading} · Marta Prieto`} description={page.description}>
  <NotepadAbout
    title={page.title}
    id="como-esta-hecho"
    level="h1"
    closeHref={localePath(lang)}
    class="window--page window--page-narrow"
    dialog
    draggable={false}
  >
    <p><a href={localePath(lang)}>{t('project.back')}</a></p>
    <p>{page.intro}</p>
    {
      page.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          <ul>{s.items.map((item) => <li>{item}</li>)}</ul>
        </>
      ))
    }
  </NotepadAbout>
</PageDesk>
