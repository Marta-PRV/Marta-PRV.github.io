---
// Ventana "Mis proyectos": un explorador de archivos estilo Windows 98 (barra de dirección
// "C:\Mis proyectos"). La lista sale de la colección `projects`, ordenada por `order`:
// AÑADIR UN PROYECTO = AÑADIR SUS DOS .mdx; la ventana crece sola (con scroll interno) y
// no hay que tocar posiciones ni CSS. Cada fila es un enlace a la página del proyecto
// (el enlace es el título; el resto de la fila lo "estira" con ::after, así el lector de
// pantalla oye solo el nombre y todo el bloque es clicable).
import Window from './Window.astro';
import WindowMenu from './WindowMenu.astro';
import Icon from './Icon.astro';
import { getProjects } from '../data/techProjects';
import type { Lang } from '../i18n/ui';
import { localePath, sectionSlug, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  index?: number;
}

const { lang, index = 0 } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const href = (id: string) => localePath(lang, `${sectionSlug(lang, 'proyectos')}/${id.replace(`${lang}/`, '')}`);
---

<Window title={t('projects.title')} id="proyectos" icon="folder" flush startClosed index={index}>
  <WindowMenu slot="menu" win="proyectos" />
  <div class="addr">
    <span class="addr__label">{t('projects.address')}</span>
    <span class="addr__box">
      <Icon name="folder" size={16} /><span>{t('projects.path')}</span>
    </span>
  </div>
  <ul class="files" aria-label={t('projects.list')}>
    {
      projects.map((p) => (
        <li class="file">
          <span class="file__icon" aria-hidden="true"><Icon name={p.data.icon} size={32} /></span>
          <div class="file__text">
            <h3 class="file__name">
              <a class="file__link" href={href(p.id)}>{p.data.title}</a>
              {p.data.tfg && <span class="badge">{t('project.tfg')}</span>}
              {p.data.clientReal && <span class="badge">{t('project.clientReal')}</span>}
            </h3>
            <p class="file__sum">{p.data.summary}</p>
            <p class="file__impact"><span class="visually-hidden">{t('project.impact')}: </span>{p.data.impact}</p>
            <p class="file__tech">{p.data.tech.join(' · ')}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Window>

<style>
  .addr {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--window-line);
  }

  .addr__box {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
    padding: 2px var(--s-2);
    color: var(--paper-text);
    background: var(--paper);
    box-shadow: var(--bevel-in);
  }

  .files {
    margin: var(--s-1);
    padding: 0;
    list-style: none;
    color: var(--paper-text);
    background: var(--paper);
    box-shadow: var(--bevel-in);
  }

  .file {
    position: relative; /* ancla del ::after del enlace */
    display: flex;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--window-line);
  }

  .file:last-child {
    border-bottom: 0;
  }

  .file__icon {
    flex: none;
  }

  .file__text {
    flex: 1;
    min-width: 0;
  }

  .file__text > * {
    margin: 0;
  }

  .file__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.2;
  }

  .file__link {
    color: var(--link);
  }

  @media (pointer: coarse), (max-width: 75.99rem), (max-height: 37.99rem) {
    .file__link {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  /* Toda la fila es el área de clic */
  .file__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .file:hover {
    background: color-mix(in srgb, var(--select) 14%, transparent);
  }

  .file:has(.file__link:focus-visible) {
    outline: 2px solid var(--select);
    outline-offset: -2px;
  }

  .file__link:focus-visible {
    outline: none;
  }

  .badge {
    padding: 1px var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: #fff;
    background: var(--select);
  }

  .file__sum {
    margin-top: 2px;
    font-size: var(--text-sm);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .file__impact {
    margin-top: var(--s-1);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
  }

  .file__tech {
    margin-top: var(--s-1);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--window-muted);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
