---
// Pegatina pixel suelta del escritorio (CD, ordenador, disquete...). Puramente
// decorativa: no recibe clics ni foco y se oculta a lectores de pantalla.
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  /** Múltiplos de 16 (48, 64, 80) para que los píxeles salgan nítidos. */
  size?: number;
  /** Giro en grados (pequeño: es un adhesivo pegado "a ojo"). */
  rotate?: number;
  class?: string;
}

const { icon, size = 64, rotate = 0, class: className } = Astro.props;
---

<span class:list={['sticker', className]} style={`--rot:${rotate}deg`} aria-hidden="true">
  <Icon name={icon} size={size} />
</span>

<style>
  .sticker {
    position: absolute;
    z-index: 0;
    color: #14172b; /* contorno del icono */
    pointer-events: none;
    rotate: var(--rot);
    filter: drop-shadow(0 2px 0 rgb(0 0 0 / 0.25));
  }
</style>
