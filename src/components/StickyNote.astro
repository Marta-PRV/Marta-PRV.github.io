---
// Nota adhesiva con datos rápidos. El contenido llega por el slot; si es una
// lista (<ul>), cada elemento lleva una casilla dibujada al estilo de la época.
interface Props {
  /** Giro en grados; pequeño y estático (nunca más de ±2°). */
  rotate?: number;
  class?: string;
}
const { rotate = -1.5, class: className } = Astro.props;
---

<div class:list={['note', className]} style={`--rotate: ${rotate}deg`}>
  <slot />
</div>

<style>
  .note {
    padding: var(--s-5) var(--s-5) var(--s-6);
    color: var(--note-text);
    background: var(--note);
    transform: rotate(var(--rotate));
    box-shadow: 0 8px 14px -6px rgb(0 0 0 / 0.35);
    font-size: var(--text-base);
  }

  .note :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note :global(li) {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    padding-block: var(--s-1);
  }

  .note :global(li)::before {
    content: '';
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid currentColor;
    transform: translateY(1px);
  }

  .note :global(a) {
    color: inherit;
    font-weight: 700;
  }
</style>
