---
// Contenido del escritorio de la portada: iconos, ventanas, pegatinas y garabato.
// Cómo se coloca (PC: collage con ventanas absolutas; móvil: rejilla de iconos y
// ventanas a pantalla completa) está en src/styles/desktop.css.
// Orden del DOM = orden de Tab: primero los iconos (proyectos a la izquierda, "Cómo
// está hecho" a la derecha), luego las ventanas.
import { getCollection } from 'astro:content';
import DesktopIcon from './DesktopIcon.astro';
import PaintPhoto from './PaintPhoto.astro';
import NotepadAbout from './NotepadAbout.astro';
import TechWindow from './TechWindow.astro';
import ContactWindow from './ContactWindow.astro';
import SocialsWindow from './SocialsWindow.astro';
import NowPlaying from './NowPlaying.astro';
import AlertDialog from './AlertDialog.astro';
import Sticker from './Sticker.astro';
import Scribble from './Scribble.astro';
import marta from '../assets/marta.jpg';
import { about } from '../data/about';
import { alerts } from '../data/alerts';
import { shortcuts } from '../data/shortcuts';
import type { Lang } from '../i18n/ui';
import { localePath, sectionSlug, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** true cuando va detrás de una ventana de página (proyecto): sin h1 duplicado ni animación de entrada. */
  behind?: boolean;
}

const { lang, behind = false } = Astro.props;
const t = useTranslations(lang);
const text = about[lang];

const projects = (await getCollection('projects', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectHref = (id: string) => localePath(lang, `${sectionSlug(lang, 'proyectos')}/${id.replace(`${lang}/`, '')}`);

function shortcutHref(s: (typeof shortcuts)[number]) {
  if (s.kind === 'external') return s.target;
  return localePath(lang, sectionSlug(lang, s.target as 'como-esta-hecho'));
}

// Iconos que solo existen en el modo móvil: abren las ventanas de la portada como "apps"
// (en PC esas ventanas ya están en el escritorio y se manejan desde la barra de tareas).
const apps = [
  { href: '#sobre-mi', icon: 'notepad' as const, label: t('nav.about') },
  { href: '#foto', icon: 'paint' as const, label: t('photo.short') },
  { href: '#tecnologias', icon: 'folder' as const, label: t('tech.short') },
  { href: '#contacto', icon: 'mail' as const, label: t('nav.contact') },
  { href: '#redes', icon: 'globe' as const, label: t('redes.short') },
];
---

<div class:list={['desktop', { 'desktop--behind': behind }]}>
  {behind ? <p class="visually-hidden">{t('home.h1')}</p> : <h1 class="visually-hidden">{t('home.h1')}</h1>}

  <!-- Columna izquierda: SOLO proyectos (en móvil la rejilla también lleva las "apps") -->
  <section class="icons icons--left" id="proyectos" aria-labelledby="h-proyectos">
    <h2 class="visually-hidden" id="h-proyectos">{t('nav.projects')}</h2>
    <ul class="icons__list">
      {
        projects.map((p) => (
          <li>
            <DesktopIcon href={projectHref(p.id)} label={p.data.iconLabel ?? p.data.title} icon={p.data.icon} />
          </li>
        ))
      }
      {
        apps.map((a) => (
          <li class="app-only">
            <DesktopIcon href={a.href} label={a.label} icon={a.icon} />
          </li>
        ))
      }
      {
        shortcuts.map((s) => (
          <li class="app-only">
            <DesktopIcon href={shortcutHref(s)} label={s.label[lang]} icon={s.icon} external={s.kind === 'external'} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Zona derecha (solo PC): accesos directos -->
  <section class="icons icons--right" aria-labelledby="h-accesos">
    <h2 class="visually-hidden" id="h-accesos">{t('home.shortcuts')}</h2>
    <ul class="icons__list">
      {
        shortcuts.map((s) => (
          <li>
            <DesktopIcon href={shortcutHref(s)} label={s.label[lang]} icon={s.icon} external={s.kind === 'external'} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Decoración (solo PC): título a mano con flecha hacia los proyectos, y pegatinas sueltas -->
  <p class="hint" aria-hidden="true">
    <span>{t('desk.hint')}</span>
    <Scribble kind="arrowDown" width={30} class="hint__arrow" />
  </p>
  <Sticker icon="cd" size={64} rotate={-8} class="sticker--cd" />
  <Sticker icon="computer" size={64} rotate={6} class="sticker--pc" />
  <Sticker icon="floppy" size={48} rotate={-5} class="sticker--floppy" />

  <PaintPhoto title={t('photo.title')} id="foto" image={marta} alt={t('photo.alt')} index={0} />
  <NotepadAbout title={t('about.title')} id="sobre-mi" index={1}>
    <p class="note-name">{text.name}</p>
    {text.paragraphs.map((p) => <p>{p}</p>)}
  </NotepadAbout>
  <TechWindow title={t('tech.title')} index={2} />
  <ContactWindow index={3} />
  <SocialsWindow index={4} />
  <NowPlaying title={t('player.title')} lang={lang} index={5} />
  {alerts.map((a, i) => <AlertDialog alert={a} lang={lang} index={6 + i} />)}
</div>

<style>
  .note-name {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .icons__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hint span {
    font-family: var(--font-marker);
    font-size: 1rem;
    line-height: 1.1;
    color: var(--ink);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.5);
  }

  /* Detrás de una ventana de página no se repite la animación de entrada */
  .desktop--behind :global(.window) {
    animation: none;
  }
</style>
