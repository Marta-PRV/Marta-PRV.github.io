---
// Página de un proyecto: una ventana grande (como abrir el icono del escritorio).
// El botón X de la barra y "← Escritorio" son enlaces reales de vuelta a la portada.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import PageDesk from './PageDesk.astro';
import Window from './Window.astro';
import CdPlayer from './CdPlayer.astro';
import TechIcon from './TechIcon.astro';
import WindowMenu from './WindowMenu.astro';
import { findTech } from '../data/techProjects';
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { data } = entry;
const t = useTranslations(lang);
const home = localePath(lang);
const { Content } = await render(entry);

// Si una tecnología está en src/data/tech.ts, su chip lleva el azulejo pixel; si no, solo el nombre.
const chips = data.tech.map((name) => ({
  name,
  known: findTech(name),
}));
---

<PageDesk lang={lang} title={`${data.title} · Marta Prieto`} description={data.summary}>
  <Window
    as="article"
    level="h1"
    title={data.title}
    id="proyecto"
    icon={data.icon}
    closeHref={home}
    class="window--page"
    dialog
    draggable={false}
    flush
  >
        <WindowMenu slot="menu" win="proyecto" backHref={home} maximize={false} />

        <div class="body">
          <header class="head">
            <div class="lead">
              <p>{data.summary}</p>
              <p class="impact">
                {data.tfg && <span class="badge">{t('project.tfg')}</span>}
                {data.clientReal && <span class="badge">{t('project.clientReal')}</span>}
                <span class="visually-hidden">{t('project.impact')}: </span>{data.impact}
              </p>
            </div>
            <div class="actions">
              <a class="btn" href={data.repo} target="_blank" rel="noopener noreferrer">
                {t('project.repo')} <span class="visually-hidden">{t('link.external')}</span>
              </a>
              {
                data.memoria && (
                  <a class="btn" href={data.memoria} target="_blank" rel="noopener noreferrer" data-memoir>
                    {t('project.memoir')} <span class="visually-hidden">{t('link.external')}</span>
                  </a>
                )
              }
            </div>
          </header>

          <section aria-label={t('project.tech')}>
            <ul class="chips">
              {
                chips.map((c) => (
                  <li class="chip">
                    {c.known && <TechIcon tech={c.known} size={16} />}
                    {c.name}
                  </li>
                ))
              }
            </ul>
          </section>

          {
            data.cover && (
              <figure class="cover">
                <Image src={data.cover} alt={data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 60rem) 100vw, 56rem" />
              </figure>
            )
          }

          {data.video && <CdPlayer videoId={data.video} title={`${t('project.video')} · ${data.title}`} poster={data.videoPoster} />}

          <div class="prose">
            <Content />
          </div>
        </div>
  </Window>
</PageDesk>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* sin esto, el contenido más ancho ensancha la columna y desborda en móvil */
    gap: var(--s-5);
    padding: var(--s-4);
    background: var(--window);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .lead {
    flex: 1 1 18rem;
    max-width: var(--measure);
    font-size: var(--text-lg);
  }

  .impact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-3);
    font-weight: 700;
  }

  .badge {
    padding: 1px var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 400;
    color: #fff;
    background: var(--select);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 3px var(--s-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    background: var(--button);
    border: 1px solid var(--button-edge);
    border-radius: 3px;
    box-shadow:
      inset 1px 1px 0 var(--button-hi),
      inset -1px -1px 0 var(--button-lo);
  }

  .cover {
    margin: 0;
    border: 1px solid var(--window-line);
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 40rem) {
    .body {
      padding: var(--s-6);
    }
  }
</style>
