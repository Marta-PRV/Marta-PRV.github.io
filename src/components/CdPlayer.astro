---
// Reproductor retro para vídeos de YouTube. Truco de rendimiento ("fachada"):
// al cargar la página NO se descarga nada de YouTube. Solo cuando alguien
// pulsa el botón se crea el <iframe> (con el dominio youtube-nocookie.com, que
// no guarda cookies hasta que se reproduce). Así el vídeo no frena la web ni
// manda datos a terceros antes de tiempo. La miniatura es una imagen LOCAL
// (descargada una vez, optimizada por astro:assets): ninguna petición a YouTube al cargar.
import { Image } from 'astro:assets';
import Window from './Window.astro';
import Icon from './Icon.astro';
import PlayerKeys from './PlayerKeys.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** ID del vídeo de YouTube (lo que va tras `youtu.be/`). */
  videoId: string;
  /** Título que se muestra en la ventana y en el visor. */
  title: string;
  /** Miniatura local del vídeo. Si falta, se muestra un CD pixel. */
  poster?: ImageMetadata;
  class?: string;
}

const { videoId, title, poster, class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Window title={title} id={`video-${videoId}`} icon="cd" level="h3" flush draggable={false} class={className}>
  <div class="player" data-video={videoId} data-title={title}>
    <div class="screen">
      <button class="screen__play" type="button" aria-label={`${t('video.play')}: ${title}`}>
        {
          poster ? (
            <Image src={poster} alt="" widths={[480, 800, 1200]} sizes="(max-width: 60rem) 90vw, 54rem" class="poster" />
          ) : (
            <Icon name="cd" size={96} />
          )
        }
        <span class="play-badge" aria-hidden="true">
          <svg viewBox="0 0 12 12" shape-rendering="crispEdges"><path d="M3 1h2v1h1v1h1v1h1v1h1v2H8v1H7v1H6v1H5v1H3z" fill="currentColor" /></svg>
        </span>
      </button>
    </div>
    <div class="deck" aria-hidden="true">
      <span class="readout">{t('video.track')} · {title}</span>
      <PlayerKeys />
    </div>
  </div>
</Window>

<style>
  .player {
    padding: var(--s-2);
  }

  .screen {
    aspect-ratio: 16 / 9;
    background: #0b0d1c;
    border: 1px solid var(--window-line);
    box-shadow: inset 1px 1px 0 #000;
  }

  .screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .screen__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    color: #cfd3f5;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .screen__play :global(.poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-badge {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: var(--window);
    color: var(--window-text);
    box-shadow: var(--bevel-out), 0 0 0 1px var(--window-edge);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .play-badge svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .screen__play:active .play-badge {
    box-shadow: var(--bevel-in), 0 0 0 1px var(--window-edge);
    transform: translateY(1px);
  }

  .deck {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-2);
  }

  .readout {
    flex: 1;
    min-width: 0;
    padding: var(--s-1) var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: #7dffb0;
    background: #0b1d16;
    border: 1px solid var(--window-line);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

</style>

<script>
  // Cambia la fachada por el vídeo real al pulsar el botón.
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((player) => {
    const button = player.querySelector<HTMLButtonElement>('.screen__play');
    const screen = player.querySelector<HTMLElement>('.screen');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${player.dataset.video}?autoplay=1&rel=0`;
      iframe.title = player.dataset.title ?? 'Vídeo';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      screen?.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
