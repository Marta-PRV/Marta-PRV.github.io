---
// Reproductor retro para vídeos de YouTube. Truco de rendimiento ("fachada"):
// al cargar la página NO se descarga nada de YouTube. Solo cuando alguien
// pulsa el botón se crea el <iframe> (con el dominio youtube-nocookie.com, que
// no guarda cookies hasta que se reproduce). Así el vídeo no frena la web ni
// manda datos a terceros antes de tiempo.
import Window from './Window.astro';
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /** ID del vídeo de YouTube (lo que va tras `youtu.be/`). */
  videoId: string;
  /** Título que se muestra en la ventana y en el visor. */
  title: string;
  class?: string;
}

const { videoId, title, class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Window title={title} id={`video-${videoId}`} icon="cd" level="h3" flush class={className}>
  <div class="player" data-video={videoId} data-title={title}>
    <div class="screen">
      <button class="screen__play" type="button" aria-label={`${t('video.play')}: ${title}`}>
        <Icon name="cd" size={96} />
        <span class="play-badge" aria-hidden="true">
          <svg viewBox="0 0 12 12" shape-rendering="crispEdges"><path d="M3 1h2v1h1v1h1v1h1v1h1v2H8v1H7v1H6v1H5v1H3z" fill="#fff" /></svg>
        </span>
      </button>
    </div>
    <div class="deck" aria-hidden="true">
      <span class="readout">{t('video.track')} · {title}</span>
      <span class="keys"><span></span><span></span><span></span><span></span></span>
    </div>
  </div>
</Window>

<style>
  .player {
    padding: var(--s-2);
  }

  .screen {
    aspect-ratio: 16 / 9;
    background: #0b0d1c;
    border: 1px solid var(--window-line);
    box-shadow: inset 1px 1px 0 #000;
  }

  .screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .screen__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 0;
    color: #cfd3f5;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .play-badge {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: var(--titlebar-a);
    border: 2px solid #fff;
    border-radius: 6px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .play-badge svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .screen__play:hover .play-badge {
    background: var(--titlebar-b);
  }

  .screen__play:active .play-badge {
    transform: translateY(1px);
  }

  .deck {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-start: var(--s-2);
  }

  .readout {
    flex: 1;
    min-width: 0;
    padding: var(--s-1) var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: #7dffb0;
    background: #0b1d16;
    border: 1px solid var(--window-line);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .keys {
    display: flex;
    gap: 2px;
  }

  .keys span {
    width: 1.5rem;
    height: 1.5rem;
    background: var(--button);
    border: 1px solid var(--button-edge);
    box-shadow:
      inset 1px 1px 0 var(--button-hi),
      inset -1px -1px 0 var(--button-lo);
  }
</style>

<script>
  // Cambia la fachada por el vídeo real al pulsar el botón.
  document.querySelectorAll<HTMLElement>('.player').forEach((player) => {
    const button = player.querySelector<HTMLButtonElement>('.screen__play');
    const screen = player.querySelector<HTMLElement>('.screen');
    button?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${player.dataset.video}?autoplay=1&rel=0`;
      iframe.title = player.dataset.title ?? 'Vídeo';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      screen?.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
