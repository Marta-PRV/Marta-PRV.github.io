---
// Ventana estilo Windows 98 (original, sin marcas). Es un <article> o <section>
// normal con su título como encabezado, así que los lectores de pantalla
// navegan por ella. Controles de la barra:
//  - minimizar y maximizar son <button> y solo aparecen cuando el gestor de
//    ventanas (windowManager.ts) está activo: sin JS no existen, para no dejar
//    botones muertos;
//  - cerrar es siempre un enlace real: a `closeHref` (p. ej. el escritorio) o a
//    "#" (en móvil, quitar el #ancla cierra la "app"). El gestor lo intercepta en PC.
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  /** Id de la ventana: es el ancla (#id), el hueco para :target en móvil y el nombre que usa el gestor. */
  id: string;
  icon?: IconName;
  /** Nivel del encabezado del título: h2 para ventanas de sección, h3 si va dentro de otra. */
  level?: 'h1' | 'h2' | 'h3';
  as?: 'article' | 'section';
  /** Quita el relleno del cuerpo (útil para vídeo o imagen a sangre). */
  flush?: boolean;
  /** Ruta a la que lleva el botón de cerrar. Por defecto, "#". */
  closeHref?: string;
  /** Si el gestor puede arrastrarla, minimizarla, etc. Los diálogos de página (proyecto) la desactivan. */
  draggable?: boolean;
  /** Ventana de página que se abre encima de todo: role="dialog" modal (el resto queda inerte). */
  dialog?: boolean;
  /** Ventana decorativa (música, avisos): empieza cerrada si no hay sitio libre en el escritorio. */
  extra?: boolean;
  /** Empieza cerrada en PC: solo se abre desde su icono, botón de la barra o Inicio (p. ej. "Mis proyectos"). */
  startClosed?: boolean;
  /** Posición en la cascada de apertura (cada paso añade ~70 ms de retraso). */
  index?: number;
  class?: string;
}

const {
  title,
  id,
  icon = 'folder',
  level = 'h2',
  as: Tag = 'section',
  flush = false,
  closeHref,
  draggable = true,
  dialog = false,
  extra = false,
  startClosed = false,
  index = 0,
  class: className,
} = Astro.props;
const Heading = level;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Tag
  class:list={['window', className]}
  id={id}
  aria-labelledby={`${id}-title`}
  data-window={id}
  data-state="open"
  role={dialog ? 'dialog' : undefined}
  aria-modal={dialog ? 'true' : undefined}
  data-draggable={draggable ? '' : undefined}
  data-extra={extra ? '' : undefined}
  data-start={startClosed ? 'closed' : undefined}
  style={`--i:${index}`}
>
  <div class="window__bar" data-drag>
    <Icon name={icon} size={16} />
    <Heading class="window__title" id={`${id}-title`}>{title}</Heading>
    {(draggable || closeHref) && (
    <span class="window__controls">
      <button class="ctl" type="button" data-action="minimize" aria-label={t('window.minimize')}>
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true"><rect x="1" y="6" width="5" height="2" fill="currentColor" /></svg>
      </button>
      <button class="ctl" type="button" data-action="maximize" aria-label={t('window.maximize')}>
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true"><path d="M0.5 0.5h7v7h-7z" fill="none" stroke="currentColor" /><rect x="0" y="0" width="8" height="2" fill="currentColor" /></svg>
      </button>
      <a class="ctl ctl--close" data-action="close" href={closeHref ?? '#'} aria-label={t('window.close')}>
        <svg viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 1l6 6M7 1L1 7" stroke="currentColor" stroke-width="1.6" /></svg>
        <span class="ctl__label" aria-hidden="true">{t('window.close')}</span>
      </a>
    </span>
    )}
  </div>
  <slot name="menu" />
  <div class:list={['window__body', { 'window__body--flush': flush }]}>
    <slot />
  </div>
</Tag>

<style>
  .window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 3px;
    color: var(--window-text);
    background: var(--window);
    border: 1px solid var(--window-edge);
    border-radius: var(--radius-window);
    box-shadow: var(--bevel-out);
  }

  .window__bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--bar-h);
    padding: 2px 3px;
    color: var(--titlebar-text);
    /* Degradado horizontal de dos tonos (azul marino -> azul), como la barra clásica */
    background: linear-gradient(to right, var(--titlebar-a), var(--titlebar-b));
  }

  /* El gestor marca las ventanas que no están delante: barra gris */
  .window[data-inactive] .window__bar {
    background: linear-gradient(to right, var(--titlebar-off-a), var(--titlebar-off-b));
  }

  /* Destello breve de la barra de título cuando algo pide atención a una ventana que ya estaba delante */
  .window[data-flash] .window__bar {
    animation: bar-flash 420ms steps(2, end) 2;
  }

  .window__title {
    flex: 1;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 400; /* Pixelify Sans solo en 400: ver DESIGN.md */
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .window__controls {
    display: flex;
    gap: 2px;
  }

  /* Botón biselado; se hunde al pulsarlo */
  .ctl {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.125rem;
    padding: 0;
    color: var(--window-text);
    background: var(--window);
    border: 0;
    box-shadow: var(--bevel-out);
    cursor: pointer;
  }

  /* Zona de clic ampliada (objetivo mínimo de 24px) sin cambiar el aspecto */
  .ctl::after {
    content: '';
    position: absolute;
    inset: -3px -2px;
  }

  .ctl:active {
    box-shadow: var(--bevel-in);
  }

  .ctl :global(svg) {
    width: 0.5rem;
    height: 0.5rem;
  }

  .ctl--close {
    margin-inline-start: 2px;
  }

  /* La palabra "Cerrar" solo se ve en modo apps (móvil), donde el botón es grande */
  .ctl__label {
    display: none;
  }

  /* Las ventanas de página (no arrastrables) solo tienen el botón de cerrar */
  .window:not([data-draggable]) .ctl:not(.ctl--close) {
    display: none;
  }

  /* El título recibe el foco al abrir una ventana (para lectores de pantalla), pero no es interactivo: sin recuadro */
  .window__title:focus {
    outline: none;
  }

  /* Minimizar y maximizar solo existen con el gestor de ventanas activo (html.wm), y no en el modo "apps" de móvil */
  :global(html:not(.wm)) .ctl:not(.ctl--close) {
    display: none;
  }

  .window__body {
    flex: 1;
    min-height: 0;
    padding: var(--s-4);
    overflow: auto;
    overscroll-behavior: contain;
    color: var(--window-text);
    background: var(--window);
    scrollbar-color: var(--window-line) var(--window);
  }

  .window__body--flush {
    padding: 0;
  }

  /* Modo apps (móvil y pantallas pequeñas): el botón de cerrar/volver es siempre visible y de al menos 44 px.
     Mismo criterio que desktop.css. En pantallas táctiles grandes (PC con dedo) también crecen los controles. */
  @media (max-width: 75.99rem), (max-height: 37.99rem) {
    .window__bar {
      min-height: 2.75rem;
    }

    .ctl--close {
      grid-auto-flow: column;
      gap: var(--s-2);
      width: auto;
      min-width: 2.75rem;
      height: 2.75rem;
      padding-inline: var(--s-3);
      font-family: var(--font-ui);
      font-size: var(--text-sm);
    }

    .ctl--close::after {
      inset: 0;
    }

    .ctl--close .ctl__label {
      display: inline;
    }

    .ctl--close :global(svg) {
      width: 0.75rem;
      height: 0.75rem;
    }
  }

  @media (pointer: coarse) {
    .ctl {
      min-width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* En pantallas estrechas solo queda el botón de cerrar: más sitio para el título */
  @media (max-width: 30rem) {
    .ctl:not(.ctl--close) {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window[data-flash] .window__bar {
      animation: none;
      filter: brightness(1.5);
    }
  }

  /* Apertura en cascada: una sola vez al cargar. Sin movimiento si el usuario lo pide. */
  @media (prefers-reduced-motion: no-preference) {
    .window {
      animation: window-open var(--dur-window) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
  }

  @keyframes bar-flash {
    50% {
      filter: brightness(1.9);
    }
  }

  @keyframes window-open {
    from {
      opacity: 0;
      scale: 0.97;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
</style>
