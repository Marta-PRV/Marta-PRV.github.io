---
// Ventana retro compacta. Es un <article> o <section> normal con su título como
// encabezado (así los lectores de pantalla navegan por ella). Los botones de la
// barra son decoración, salvo el de cerrar cuando se pasa `closeHref`: entonces
// es un enlace real de vuelta al escritorio.
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { getLangFromUrl, localePath, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  /** Id del encabezado (para aria-labelledby y para enlaces tipo #proyectos). */
  id: string;
  icon?: IconName;
  /** Nivel del encabezado del título: h2 para ventanas de sección, h3 si va dentro de otra. */
  level?: 'h1' | 'h2' | 'h3';
  as?: 'article' | 'section';
  /** Quita el relleno del cuerpo (útil para vídeo o imagen a sangre). */
  flush?: boolean;
  /** Si se indica, el botón de cerrar es un enlace a esta ruta (p. ej. el escritorio). */
  closeHref?: string;
  /** Posición en la cascada de apertura (cada paso añade ~70 ms de retraso). */
  index?: number;
  class?: string;
}

const {
  title,
  id,
  icon = 'folder',
  level = 'h2',
  as: Tag = 'section',
  flush = false,
  closeHref,
  index = 0,
  class: className,
} = Astro.props;
const Heading = level;
const lang = getLangFromUrl(Astro.url);
const closeLabel = useTranslations(lang)('window.close');
const closeX = '<svg viewBox="0 0 8 8" shape-rendering="crispEdges"><path d="M1 1l6 6M7 1L1 7" stroke="#fff" stroke-width="1.6" /></svg>';
---

<Tag class:list={['window', className]} aria-labelledby={id} style={`--i:${index}`}>
  <div class="window__bar">
    <Icon name={icon} size={16} />
    <Heading class="window__title" id={id}>{title}</Heading>
    <span class="window__controls">
      <span class="ctl" aria-hidden="true"><svg viewBox="0 0 8 8" shape-rendering="crispEdges"><rect x="1" y="5" width="5" height="2" fill="#fff" /></svg></span>
      <span class="ctl" aria-hidden="true"><svg viewBox="0 0 8 8" shape-rendering="crispEdges"><path d="M1 1h6v6H1z" fill="none" stroke="#fff" stroke-width="1.5" /></svg></span>
      {closeHref ? (
        <a class="ctl ctl--close ctl--link" href={closeHref} aria-label={closeLabel} set:html={closeX} />
      ) : (
        <span class="ctl ctl--close" aria-hidden="true" set:html={closeX} />
      )}
    </span>
  </div>
  <slot name="menu" />
  <div class:list={['window__body', { 'window__body--flush': flush }]}>
    <slot />
  </div>
</Tag>

<style>
  .window {
    /* Marco azul de 3px a los lados y abajo, como las ventanas de la época */
    background: var(--titlebar-a);
    padding: 0 3px 3px;
    border-radius: var(--radius-window) var(--radius-window) 3px 3px;
    box-shadow: var(--shadow-window);
    min-width: 0;
  }

  .window__bar {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--bar-h);
    padding: 0 var(--s-1) 0 var(--s-2);
    color: var(--titlebar-text);
    background: linear-gradient(to bottom, var(--titlebar-b), var(--titlebar-a));
    border-radius: calc(var(--radius-window) - 1px) calc(var(--radius-window) - 1px) 0 0;
  }

  .window__title {
    flex: 1;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 400; /* Pixelify Sans solo en 400: ver DESIGN.md */
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.4);
  }

  .window__controls {
    display: flex;
    gap: 2px;
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    background: var(--titlebar-b);
    border: 1px solid #fff;
    border-radius: 3px;
  }

  .ctl :global(svg) {
    width: 0.4375rem;
    height: 0.4375rem;
  }

  .ctl--close {
    background: #d9402a;
  }

  /* El enlace de cerrar conserva el tamaño visual pero amplía su zona táctil */
  .ctl--link {
    position: relative;
  }

  .ctl--link::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
  }

  .window__body {
    padding: var(--s-4);
    background: var(--window);
    color: var(--window-text);
  }

  .window__body--flush {
    padding: 0;
  }

  /* En pantallas estrechas solo queda el botón de cerrar: más sitio para el título */
  @media (max-width: 30rem) {
    .ctl:not(.ctl--close) {
      display: none;
    }
  }

  /* Apertura en cascada: una sola vez al cargar. Sin movimiento si el usuario lo pide. */
  @media (prefers-reduced-motion: no-preference) {
    .window {
      animation: window-open var(--dur-window) var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
  }

  @keyframes window-open {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
