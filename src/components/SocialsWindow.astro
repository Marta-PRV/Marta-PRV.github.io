---
// Ventana "Mis redes": un azulejo cuadrado por red (como los de "Mis tecnologías")
// con su logo oficial sin deformar, y un botón que abre el perfil en pestaña nueva.
// Los azulejos son siempre BLANCOS (también en modo oscuro): los logos oficiales
// están pensados para fondo claro y no deben recolorearse.
import Window from './Window.astro';
import LinkedInLogo from './brand/LinkedInLogo.astro';
import GitHubMark from './brand/GitHubMark.astro';
import { socials } from '../data/socials';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  index?: number;
}

const { index = 0 } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<Window title={t('redes.title')} id="redes" icon="globe" index={index}>
  <ul class="nets">
    {
      socials.map((s) => (
        <li class="nets__row">
          <span class="tile">
            {s.id === 'linkedin' ? <LinkedInLogo size={32} /> : <GitHubMark size={32} />}
          </span>
          <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer">
            {t(s.cta)}
            <span class="visually-hidden">{t('link.external')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Window>

<style>
  .nets {
    display: grid;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nets__row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* Azulejo cuadrado: mismo borde oscuro que los de tecnologías; el logo respeta un margen de seguridad */
  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: #ffffff;
    border: 1px solid #16182a;
  }

  .nets__row .btn {
    flex: 1;
    padding-inline: var(--s-2);
    white-space: nowrap;
  }
</style>
