---
// Fondo propio: cielo en bandas + nubes + estrellas + dos filas de colinas.
// Está hecho solo con rectángulos en una cuadrícula de 320x180 "píxeles", así
// que escala nítido y toma los colores de los tokens (claro/oscuro).
const W = 320;
const H = 180;
const STEP = 3; // las colinas suben y bajan de 3 en 3 píxeles (aspecto escalonado)

/** Silueta de colina: une columnas contiguas de igual altura en un solo rectángulo. */
function hillRuns(base: number, a1: number, f1: number, p1: number, a2: number, f2: number) {
  const runs: { x: number; w: number; top: number }[] = [];
  for (let x = 0; x < W; x++) {
    const raw = base - (a1 * Math.sin(x / f1 + p1) + a2 * Math.sin(x / f2));
    const top = Math.round(raw / STEP) * STEP;
    const last = runs[runs.length - 1];
    if (last && last.top === top) last.w++;
    else runs.push({ x, w: 1, top });
  }
  return runs;
}

const back = hillRuns(112, 14, 37, 0.6, 7, 17);
const front = hillRuns(138, 11, 53, 2.1, 5, 23);

const bands = [
  { y: 0, h: 44, fill: 'var(--sky-1)' },
  { y: 44, h: 40, fill: 'var(--sky-2)' },
  { y: 84, h: 34, fill: 'var(--sky-3)' },
  { y: 118, h: 62, fill: 'var(--sky-4)' },
];

/** Una nube = 4 filas de píxeles. */
function cloud(x: number, y: number) {
  return [
    { x: x + 3, y, w: 6 },
    { x: x + 1, y: y + 1, w: 10 },
    { x, y: y + 2, w: 13 },
    { x: x + 2, y: y + 3, w: 9 },
  ];
}
const clouds = [...cloud(22, 20), ...cloud(190, 12), ...cloud(120, 46), ...cloud(268, 54)];

// Estrellas: posiciones fijas (pseudoaleatorias deterministas) para que no cambien entre builds.
const stars = Array.from({ length: 46 }, (_, i) => ({
  x: (i * 97 + 31) % W,
  y: (i * 53 + 7) % 92,
}));
---

<svg
  class="hills"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {bands.map((b) => <rect x="0" y={b.y} width={W} height={b.h} fill={b.fill} />)}
  <g fill="var(--star)">
    {stars.map((s) => <rect x={s.x} y={s.y} width="1" height="1" />)}
  </g>
  <g class="clouds" fill="var(--cloud)">
    {clouds.map((c) => <rect x={c.x} y={c.y} width={c.w} height="1" />)}
  </g>
  <g fill="var(--hill-back)">
    {back.map((r) => <rect x={r.x} y={r.top} width={r.w} height={H - r.top} />)}
  </g>
  <g fill="var(--hill-front)">
    {front.map((r) => <rect x={r.x} y={r.top} width={r.w} height={H - r.top} />)}
  </g>
  <g fill="var(--hill-light)">
    {front.map((r) => <rect x={r.x} y={r.top} width={r.w} height="1" />)}
  </g>
</svg>

<style>
  .hills {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
