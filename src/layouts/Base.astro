---
// Plantilla base de todas las páginas: <head>, tema, fuentes, fondo, barra de
// tareas y el hueco <main>, más todo el SEO: Open Graph, Twitter, hreflang y JSON-LD.
// Pixelify Sans SOLO en peso 400: en 500/700 se rellenan los huecos de las letras
// ("Contacto" se lee "Oontacto"). Nunca usar font-weight > 400 con --font-ui.
import '@fontsource/pixelify-sans/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400-italic.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/permanent-marker/latin-400.css';
import pixelifyFont from '@fontsource/pixelify-sans/files/pixelify-sans-latin-400-normal.woff2?url';
import atkinsonFont from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/desktop.css';

import Hills from '../components/Hills.astro';
import Taskbar from '../components/Taskbar.astro';
import type { Lang } from '../i18n/ui';
import { socials } from '../data/socials';
import { alternatePath, localePath, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  /** true en páginas que no deben indexarse (404). */
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t('site.title');
const description = Astro.props.description ?? t('site.description');
const other: Lang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(alternatePath(Astro.url, other), Astro.site);
const ogImage = new URL('/og/preview.png', Astro.site);
const ogAlt = t('seo.imageAlt');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';

// Datos estructurados: quién es Marta (en todas las páginas, para que cualquiera pueda llegar desde un proyecto).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marta Prieto',
  url: new URL(localePath(lang), Astro.site).href,
  image: new URL('/og/preview.png', Astro.site).href,
  jobTitle: t('seo.jobTitle'),
  description: t('site.description'),
  knowsAbout: ['Web development', 'Frontend', 'Artificial intelligence', 'Video games'],
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : alternate} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:site_name" content="Marta Prieto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_GB' : 'es_ES'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- Las dos fuentes que se ven al entrar: se piden ya, sin esperar al CSS. -->
    <link rel="preload" href={pixelifyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonFont} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <!-- Pone el tema (claro/oscuro) ANTES de pintar, para evitar el parpadeo. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('nav.skip')}</a>
    <Hills />
    <main id="contenido">
      <slot />
    </main>
    <Taskbar lang={lang} />
    <!-- Anti-parpadeo: aplica YA las posiciones guardadas de las ventanas (antes del primer pintado).
         Es una versión mínima de lo que hace windowManager.ts al arrancar. -->
    <script is:inline>
      (function () {
        try {
          var saved = JSON.parse(sessionStorage.getItem('desk:v1') || 'null');
          if (!saved || !matchMedia('(min-width: 76rem) and (min-height: 38rem)').matches) return;
          for (var id in saved.w) {
            var el = document.querySelector('.desk .window[data-window="' + id + '"][data-draggable]');
            if (!el) continue;
            var st = saved.w[id];
            el.style.setProperty('--dx', st.dx + 'px');
            el.style.setProperty('--dy', st.dy + 'px');
            el.dataset.state = st.s;
            if (st.m) el.setAttribute('data-max', '');
            if (st.s === 'open' && el.hasAttribute('data-extra')) el.setAttribute('data-shown', '');
          }
        } catch (e) {}
      })();
    </script>
    <script>
      import '../scripts/windowManager';
    </script>
  </body>
</html>
